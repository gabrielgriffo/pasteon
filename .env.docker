# ============================================
# MYSQL DATABASE CONFIGURATION (DOCKER)
# ============================================
# These values match the docker-compose.yml configuration
# Used when running the application in Docker

VITE_MYSQL_HOST=mysql
VITE_MYSQL_PORT=3306
VITE_MYSQL_DATABASE=document_form
VITE_MYSQL_USER=appuser
VITE_MYSQL_PASSWORD=apppassword

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
# Copy your AI provider keys here or pass them via docker-compose

# AI Provider Selection ('ollama', 'gemini', 'groq', or 'openrouter')
VITE_AI_PROVIDER=gemini

# ============================================
# OLLAMA (LOCAL AI)
# ============================================
# Use host.docker.internal to access Ollama running on host machine
VITE_OLLAMA_URL=http://host.docker.internal:11434
VITE_OLLAMA_MODEL=llama3.2

# ============================================
# GOOGLE GEMINI (CLOUD AI)
# ============================================
# Get your API key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-2.0-flash-exp

# ============================================
# GROQ (CLOUD AI - ULTRA FAST)
# ============================================
# Get your free API key at: https://console.groq.com/
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=llama3-8b-8192

# ============================================
# OPENROUTER (CLOUD AI - MULTI-MODEL)
# ============================================
# Get your free API key at: https://openrouter.ai/
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# ============================================
# API PROXY CONFIGURATION
# ============================================
# Target URL for the Vite proxy (to bypass CORS restrictions)
# Example: https://usapi.spearwatch.com
VITE_API_TARGET=https://your-api-domain.com
