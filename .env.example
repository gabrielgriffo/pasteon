# Supabase Configuration
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# API PROXY CONFIGURATION
# ============================================
# Target URL for the Vite proxy (to bypass CORS restrictions)
# Example: https://usapi.spearwatch.com
VITE_API_TARGET=https://your-api-domain.com

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
# Choose: 'ollama' (local), 'gemini' (cloud), 'groq' (cloud ultra-fast), or 'openrouter' (cloud multi-model)
VITE_AI_PROVIDER=gemini

# ============================================
# OLLAMA (LOCAL)
# ============================================
# URL of your local Ollama server
VITE_OLLAMA_URL=http://localhost:11434

# Model to use (must be installed: ollama pull <model>)
# Examples: llama3.2, qwen2.5:3b, mistral, codellama
VITE_OLLAMA_MODEL=llama3.2

# ============================================
# GOOGLE GEMINI (CLOUD)
# ============================================
# Get your API key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Available models: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash
VITE_GEMINI_MODEL=gemini-2.0-flash-exp

# ============================================
# GROQ (CLOUD - ULTRA FAST)
# ============================================
# Get your free API key at: https://console.groq.com/
VITE_GROQ_API_KEY=your_groq_api_key_here

# Available models: llama3-8b-8192, llama3-70b-8192, mixtral-8x7b-32768, gemma-7b-it
VITE_GROQ_MODEL=llama3-8b-8192

# ============================================
# OPENROUTER (CLOUD - MULTI-MODEL)
# ============================================
# Get your free API key at: https://openrouter.ai/
# Access to 100+ models from OpenAI, Anthropic, Meta, Google, Mistral, etc.
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Available models (see full list at https://openrouter.ai/docs/models):
# Free models: meta-llama/llama-3.2-3b-instruct:free, google/gemini-flash-1.5:free
# Paid models: openai/gpt-4, anthropic/claude-3-opus, etc.
VITE_OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
